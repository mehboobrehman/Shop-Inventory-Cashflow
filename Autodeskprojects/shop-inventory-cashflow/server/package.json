{
  "name": "@shop/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Prisma + TypeScript backend for Shop Inventory & Account Management System",
  "scripts": {
    "dev": "prisma generate && bun run --hot src/index.ts",
    "compile": "tsc",
    "start": "bun run dist/src/index.js",
    "postbuild": "rm -rf dist/src/generated && cp -R src/generated dist/src/",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --project prisma/tsconfig.json --transpile-only prisma/seed.ts",
    "db:generate": "prisma generate",
    "docker:start": "prisma generate && prisma migrate dev && ts-node --project prisma/tsconfig.json --transpile-only prisma/seed.ts && ts-node-dev --respawn src/index.ts"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.json --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@shop/shared": "file:../shared",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.13",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
