# ── Database ──────────────────────────────────────────────
# Local dev (host): use localhost. Inside Docker: use db.
DATABASE_URL=postgresql://shopadmin:shoplocaldev123@localhost:5432/shop_inventory

# ── Authentication ────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Client (Vite) ─────────────────────────────────────────
# Base URL for API calls from the browser (used in local dev)
VITE_API_URL=http://localhost:4000
